# Copy to .env and edit as needed. `make serve` loads this file if it exists.
# It is gitignored, so machine-local settings and keys stay out of version control.

# Bind address. 0.0.0.0 also answers other devices on your LAN.
HOST ?= 127.0.0.1

# Port. Leave at 8000 and clients use http://127.0.0.1:8000/v1/systemone
PORT ?= 8004

# torch device: cpu, cuda, or mps. Use cuda or mps if you have that hardware.
DEVICE ?= cpu

# Checkpoints to hold in memory. Preloading everything costs a few GB of RAM but
# removes the multi-second reload that the lazy default pays on a language switch.
MODELS ?= english,multilingual,typed-decisions

# 1 to start loading the checkpoints before the first request arrives.
PRELOAD ?= 1

# Cap torch's intra-op threads. Oversubscribing logical cores hurts CPU throughput.
THREADS ?= 8

# Set to require `Authorization: Bearer <key>`. Needed only for a shared or
# network-reachable server; localhost clients can leave it empty.
LAYA_API_KEY ?=

# Where the checkpoints are cached. Defaults to .cache/huggingface in the project.
# HF_HOME ?= .cache/huggingface
