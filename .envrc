# Container-only overrides. Nothing here is needed when you run the project on
# your own machine; `source .envrc` (or direnv) picks them up if you do want it.
#
# The agent container's $HOME is read-only, so uv cannot write its usual cache or its
# managed Python interpreters under ~/.local/share. Both are kept in the project
# instead, for the same reason the environment directory is overridden.

export UV_CACHE_DIR="$PWD/.uv-cache"
export UV_PYTHON_INSTALL_DIR="$PWD/.uv-python"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv-agent-container}"
